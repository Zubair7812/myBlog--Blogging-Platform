{
    "experimentalServices": {
        "frontend": {
            "root": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/app.js",
            "routePrefix": "/api"
        }
    },
    "rewrites": [
        {
            "source": "/thumbnails/:path*",
            "destination": "/api/thumbnails/:path*"
        }
    ]
}
